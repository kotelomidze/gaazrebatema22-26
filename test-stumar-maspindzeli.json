      "stanzas": [
        [
          "„ხომ მაგას არ მოვუკლავდით",
          "მტრებს, ავს რომ არ სჩადიოდენ?",
          "კარგი ვაჟკაცი ყოფილა,",
          "ყველა ალლახსა ჰფიცავდა,"
