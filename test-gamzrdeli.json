        [
          "ერთმანეთის მინამსგავსი,",
          "შიში სხვაა, სიფრთხილე – სხვა,",
          "ისე, როგორც სხვადასხვაა",
          "ღვთის წყალობა და ღვთის რისხვა."
        ],
        [
          "რომ მიდიხარ, სად მიდიხარ?",
          "მართალია, გიჭრის თვალი,",
          "მაგრამ ჩვენში როგორც უცხოს,",
          "აგებნევა გზა და კვალი."
